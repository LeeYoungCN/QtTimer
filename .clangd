# .clangd
CompileFlags:
  CompilationDatabase: out/build      # 确认该目录下直接有 compile_commands.json

Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders
  HeaderInsertion: IWYU               # 补全时按 IWYU 自动补齐所属头（原来是无效键）

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: None
  ClangTidy:
    Add: []
    Remove:
      - misc-include-cleaner     # 编辑器用 clangd 自带 Include Cleaner，CI 用 clang-tidy 的
    FastCheckFilter: Loose

InlayHints:
  Enabled: true
  BlockEnd: false
  Designators: true
  ParameterNames: true
  DeducedTypes: true
  DefaultArguments: true
  TypeNameLimit: 24

Hover:
  ShowAKA: true
